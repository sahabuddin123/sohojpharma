# ==============================================================================
# SohojPharma Production Environment Variables Template
# Domain: https://sohojpharma.cloud
# ==============================================================================

# Node & Application Configuration
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
APP_URL=https://sohojpharma.cloud
VITE_APP_URL=https://sohojpharma.cloud
APP_PUBLIC_URL=https://sohojpharma.cloud

# Supabase API Settings
# If running self-hosted Supabase locally on the server via Docker:
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL Connection (Self-hosted or Managed)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres
LOVABLE_DB_MIGRATION_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres

# bKash Merchant Payment Gateway Settings
# Enter your bKash Checkout credentials in .env (never commit secrets)
BKASH_MERCHANT_NUMBER=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=false

# SMTP WebMail Settings (Forgot Password / Notifications)
# WebMail URL: http://mail.sohojpharma.cloud
SMTP_HOST=mail.sohojpharma.cloud
SMTP_PORT=587
SMTP_USER=support@sohojpharma.cloud
SMTP_PASS=
SMTP_ADMIN_EMAIL=support@sohojpharma.cloud
SMTP_SENDER_NAME="SohojPharma"
EMAIL_FROM="SohojPharma <support@sohojpharma.cloud>"

# Optional OpenAI / LLM features
OPENAI_API_KEY=
